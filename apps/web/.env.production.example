# ============================================================================
# Vocabotics Frontend - Production Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env.production and fill in real values
# Never commit .env.production to Git!
# ============================================================================

# === API ENDPOINTS ===
# Production API URL
VITE_API_URL=https://api.vocabotics.com

# Production WebSocket URL
VITE_WS_URL=wss://api.vocabotics.com

# === STRIPE ===
# Stripe publishable key (safe to expose in frontend)
# Get from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_YOUR_ACTUAL_STRIPE_PUBLISHABLE_KEY

# === ENVIRONMENT ===
VITE_APP_ENV=production
VITE_APP_NAME=Vocabotics
VITE_APP_VERSION=1.0.0

# === SENTRY (Optional - Error Tracking) ===
# Sentry DSN for frontend error tracking
# Get from: https://sentry.io/
VITE_SENTRY_DSN=https://xxxxxxxxxx@xxxxxxxxxx.ingest.sentry.io/xxxxxxxxxx

# === ANALYTICS (Optional) ===
# Google Analytics Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog API key and host
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://app.posthog.com

# === FEATURE FLAGS ===
# Enable/disable features in production
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_TRACKING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true

# === DOCUMENTATION LINKS ===
VITE_DOCS_URL=https://docs.vocabotics.com
VITE_SUPPORT_URL=https://support.vocabotics.com
VITE_STATUS_URL=https://status.vocabotics.com

# === SOCIAL LINKS ===
VITE_GITHUB_URL=https://github.com/vocabotics
VITE_TWITTER_URL=https://twitter.com/vocabotics
VITE_LINKEDIN_URL=https://linkedin.com/company/vocabotics

# === CDN (Optional) ===
# CloudFlare CDN URL for static assets
VITE_CDN_URL=https://cdn.vocabotics.com

# === TIMEOUTS ===
# API request timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT=30000

# WebSocket reconnection timeout in milliseconds (default: 3000)
VITE_WS_RECONNECT_TIMEOUT=3000

# === DEBUG (Production should be false) ===
VITE_DEBUG=false
VITE_SHOW_DEV_TOOLS=false

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
# [  ] VITE_API_URL points to production API (https://api.vocabotics.com)
# [  ] VITE_WS_URL points to production WebSocket (wss://api.vocabotics.com)
# [  ] VITE_STRIPE_PUBLISHABLE_KEY is a LIVE key (pk_live_*)
# [  ] VITE_APP_ENV is set to "production"
# [  ] VITE_DEBUG is set to false
# [  ] VITE_SHOW_DEV_TOOLS is set to false
# [  ] Sentry DSN is configured for production project
# [  ] Analytics IDs are for production properties
# [  ] All URLs are HTTPS (not HTTP)
# [  ] .env.production is in .gitignore
# [  ] Secrets are also set in Vercel environment variables
# [  ] Test build locally: pnpm build && pnpm preview
# ============================================================================
