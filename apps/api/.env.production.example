# ============================================================================
# Vocabotics API - Production Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env.production and fill in real values
# Never commit .env.production to Git!
# ============================================================================

# === NODE ENVIRONMENT ===
NODE_ENV=production
API_PORT=3001

# === DATABASE ===
# Production PostgreSQL connection string
# Neon: postgresql://user:pass@ep-cool-darkness-123456.us-east-2.aws.neon.tech/vocabotics?sslmode=require
# Supabase: postgresql://postgres:pass@db.project.supabase.co:5432/postgres
DATABASE_URL="postgresql://user:password@host:5432/vocabotics?sslmode=require"

# === REDIS ===
# Upstash Redis connection
# Format: rediss://default:password@redis-host.upstash.io:6379
REDIS_URL="rediss://default:password@your-redis.upstash.io:6379"

# === VECTOR DATABASE ===
# Qdrant Cloud
QDRANT_URL="https://your-cluster-id.qdrant.io"
QDRANT_API_KEY="your-qdrant-api-key"

# === AI SERVICES ===
# OpenRouter API key (primary AI provider)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Anthropic API key (optional, for direct access)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === AUTHENTICATION ===
# JWT secret key - MUST be at least 32 characters
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-required-here"
JWT_EXPIRES_IN="7d"

# === STRIPE PAYMENT PROCESSING ===
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_REPLACE_WITH_YOUR_ACTUAL_STRIPE_SECRET_KEY"
STRIPE_PUBLISHABLE_KEY="pk_live_REPLACE_WITH_YOUR_ACTUAL_STRIPE_PUBLISHABLE_KEY"

# Stripe webhook secret (for webhook signature verification)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_WITH_YOUR_ACTUAL_WEBHOOK_SECRET"

# === GITHUB INTEGRATION ===
# GitHub OAuth App credentials
# Create at: https://github.com/settings/developers
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"
GITHUB_REDIRECT_URI="https://api.vocabotics.com/api/github/callback"

# === CLOUDFLARE R2 STORAGE ===
# Get from: https://dash.cloudflare.com/
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="vocabotics-storage"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_PUBLIC_URL="https://storage.vocabotics.com"

# === DOCKER ===
# Docker daemon connection for code execution
DOCKER_HOST="unix:///var/run/docker.sock"
DOCKER_CERT_PATH=""
DOCKER_TLS_VERIFY=""

# === CORS CONFIGURATION ===
# Comma-separated list of allowed origins
CORS_ORIGIN="https://vocabotics.com,https://www.vocabotics.com"

# === ENCRYPTION ===
# Encryption key for API keys (AES-256, must be 64 hex characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="your-64-character-hex-encryption-key-for-aes-256-encryption"

# === MONITORING & LOGGING ===
# Sentry DSN for error tracking (optional but recommended)
# Get from: https://sentry.io/
SENTRY_DSN="https://xxxxxxxxxx@xxxxxxxxxx.ingest.sentry.io/xxxxxxxxxx"

# Log level (error, warn, info, debug)
LOG_LEVEL="info"

# === RATE LIMITING ===
# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# === EMAIL (Optional - for notifications) ===
# SMTP configuration if using email notifications
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD="your-sendgrid-api-key"
SMTP_FROM="noreply@vocabotics.com"

# === FEATURE FLAGS ===
# Enable/disable features
ENABLE_BYOK=true
ENABLE_VISUAL_TESTING=true
ENABLE_COMPLIANCE_CHECKS=true

# === PERFORMANCE ===
# Database connection pool size
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis connection pool size
REDIS_POOL_MIN=2
REDIS_POOL_MAX=10

# === SECURITY ===
# Bcrypt password hashing rounds (10-12 recommended)
BCRYPT_ROUNDS=10

# Session timeout in seconds (default: 7 days)
SESSION_TIMEOUT=604800

# === API VERSIONING ===
API_VERSION="v1"

# === WEBHOOKS ===
# Webhook signing secret for outgoing webhooks
WEBHOOK_SIGNING_SECRET="your-webhook-signing-secret"

# === ANALYTICS (Optional) ===
# Google Analytics tracking ID
GA_TRACKING_ID="G-XXXXXXXXXX"

# PostHog API key (optional)
POSTHOG_API_KEY="phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# === CUSTOM DOMAIN ===
API_BASE_URL="https://api.vocabotics.com"
WEB_BASE_URL="https://vocabotics.com"

# ============================================================================
# PRODUCTION CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
# [  ] All secrets are real production values (not examples)
# [  ] JWT_SECRET is at least 32 characters and randomly generated
# [  ] ENCRYPTION_KEY is 64 hex characters
# [  ] Database URL uses SSL (sslmode=require)
# [  ] CORS_ORIGIN only includes your production domains
# [  ] Stripe keys are LIVE keys (sk_live_*, pk_live_*)
# [  ] Sentry DSN is configured for error tracking
# [  ] All API keys are from production accounts
# [  ] .env.production is in .gitignore
# [  ] Secrets are also set in hosting platform (Railway/Fly.io)
# [  ] Backup of all secrets stored securely offline
# ============================================================================
