# ============================================================================
# Vocabotics Environment Configuration
# ============================================================================

# Database
DATABASE_URL="postgresql://vocabotics:vocabotics_dev_password@localhost:5432/vocabotics"

# Redis
REDIS_URL="redis://localhost:6379"

# Qdrant Vector Database
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY=""

# OpenRouter API
OPENROUTER_API_KEY="your-openrouter-api-key-here"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# JWT & Security
JWT_SECRET="change-this-to-a-random-secret-in-production"
JWT_EXPIRES_IN="7d"
ENCRYPTION_KEY="change-this-to-a-32-byte-hex-key" # For BYOK encryption

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Application
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000
ADMIN_PORT=3002

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:3002"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# AI Configuration
DEFAULT_AI_MODEL="anthropic/claude-sonnet-4.5"
HAIKU_MODEL="anthropic/claude-haiku"
VISION_MODEL="anthropic/claude-vision"
MAX_TOKENS_PRD=8000
MAX_TOKENS_ARCHITECTURE=16000
MAX_TOKENS_CODE=32000

# Feature Flags
FEATURE_BYOK_ENABLED=true
FEATURE_VISUAL_TESTING_ENABLED=true
FEATURE_ADMIN_PORTAL_ENABLED=true

# Monitoring (Optional)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Storage (for screenshots, etc.)
# Using local filesystem for development
# In production, use S3/R2
STORAGE_TYPE="local"
STORAGE_PATH="./uploads"

# CloudFlare R2 (Production)
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
